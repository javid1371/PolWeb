{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#1c1c1c",
          "name": "جای‌نگهدار متن",
          "slug": "placeholder-ink"
        },
        {
          "color": "#f6f5f2",
          "name": "جای‌نگهدار زمینه",
          "slug": "placeholder-paper"
        }
      ]
    },
    "custom": {
      "direction": "rtl"
    },
    "layout": {
      "allowCustomContentAndWideSize": false,
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": false
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--placeholder-paper)",
      "text": "var(--wp--preset--color--placeholder-ink)"
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "سربرگ"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "پابرگ"
    }
  ]
}
